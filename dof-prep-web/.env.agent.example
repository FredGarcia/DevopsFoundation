# DOF-PREP — Agent IA compagnon (optionnel) — exemple de configuration.
# Copiez ce fichier en ".env.agent" (ou exportez ces variables directement
# dans votre shell) puis lancez : python3 dof-prep-agent.py
#
# Rien ici n'est requis pour utiliser DOF-PREP : sans agent, ou sans cle,
# l'application continue de fonctionner integralement hors-ligne.

# Cle API Anthropic (console.anthropic.com). Obligatoire pour que les boutons
# "Analyser mes lacunes" et "Proposer des questions" fonctionnent reellement.
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# Hote d'ecoute. NE PAS exposer sur le reseau (voir README_agent.md, section
# securite) sans comprendre le risque : le CORS est volontairement permissif.
DOF_AGENT_HOST=127.0.0.1

# Port d'ecoute.
DOF_AGENT_PORT=8799

# Modele Anthropic utilise pour les deux fonctions. Verifiez la disponibilite
# et les tarifs actuels sur docs.claude.com si vous changez cette valeur.
DOF_AGENT_MODEL=claude-sonnet-5
