# Normaliser tout en texte avec fin de ligne LF dans le repo
* text=auto eol=lf

# Scripts et fichiers où LF est obligatoire
*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.env* text eol=lf

# Fichiers purement binaires (pas de conversion de fins de ligne)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.exe  binary
*.dll  binary

# Cas Windows spécifiques : garder CRLF si vraiment nécessaire
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf