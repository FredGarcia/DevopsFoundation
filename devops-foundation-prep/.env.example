# .env.example — DOF-PREP : variables d'environnement (toutes OPTIONNELLES)
# Copier ce fichier en .env et decommenter/adapter les lignes voulues.
# Le lanceur start.sh charge automatiquement un fichier .env present a cote.

# --- Reseau / stockage ---
# DOF_HOST=127.0.0.1             # 0.0.0.0 en conteneur
# DOF_PORT=8765
# DOF_DB_PATH=dofprep.sqlite3
# DOF_OPEN_BROWSER=1             # 0 pour ne pas ouvrir le navigateur (serveur / Docker)
# DOF_LOCALE=fr

# --- Couche de second ordre (cybernetique des systemes observants) ---
# Calibration metacognitive + auto-calibration de l'instrument de mesure.
# Desactivee par defaut ; mettre a 1 pour l'activer par defaut.
# DOF_SECOND_ORDER=0
#
# Parametres de la BOUCLE REFLEXIVE (bornes de surete appliquees au demarrage) :
#
#   DOF_ELO_K — gain de la mise a jour mutuelle aptitude <-> difficulte latente
#   (Elo leger sur echelle logit). Plus eleve = adaptation plus rapide mais plus
#   nerveuse. Borne a [0,1]. Defaut 0.08.
# DOF_ELO_K=0.08
#
#   DOF_CALIB_MIN_RECORDS — nombre minimal de predictions de confiance avant que
#   la calibration n'influe sur la preparation (anti-oscillation). Entier >= 1.
#   Defaut 20.
# DOF_CALIB_MIN_RECORDS=20
#
#   DOF_CALIB_FLOOR — plancher du facteur de calibration : la preparation peut
#   etre amortie par une mauvaise calibration, jamais effondree. Le seuil officiel
#   de reussite (65 %) n'est JAMAIS abaisse. Borne a [0,1]. Defaut 0.60.
# DOF_CALIB_FLOOR=0.60